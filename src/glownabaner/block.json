{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ourblocktheme/glownabaner",
  "title": "Główna Baner",
  "attributes": {
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "avatar1": {
      "type": "string",
      "default": ""
    },
    "avatar2": {
      "type": "string",
      "default": ""
    },
    "avatar3": {
      "type": "string",
      "default": ""
    },
    "avatar4": {
      "type": "string",
      "default": ""
    },
    "avatar5": {
      "type": "string",
      "default": ""
    },
    "ratingCount": {
      "type": "string",
      "default": "+300K Opinii"
    },
    "ratingScore": {
      "type": "string",
      "default": "4.9"
    },
    "bannerImage": {
      "type": "string",
      "default": ""
    },
    "bannerImageMobile": {
      "type": "string",
      "default": ""
    },
    "bannerTitle": {
      "type": "string",
      "default": "15% zniżki z kodem:"
    },
    "bannerTitleAccent": {
      "type": "string",
      "default": "WOMAN15"
    },
    "bannerSubtitle": {
      "type": "string",
      "default": ""
    },
    "bannerCtaLabel": {
      "type": "string",
      "default": "Dowiedz się więcej"
    },
    "bannerCtaLabelMobile": {
      "type": "string",
      "default": "Dowiedz się więcej"
    },
    "bannerCtaURL": {
      "type": "string",
      "default": "/sklep"
    },
    "titleColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "titleFontSize": {
      "type": "string",
      "default": "42px"
    },
    "titleFontSizeMobile": {
      "type": "string",
      "default": "24px"
    },
    "titleFontFamily": {
      "type": "string",
      "default": "Be Vietnam Pro"
    },
    "titleFontWeight": {
      "type": "string",
      "default": "500"
    },
    "titleLineHeight": {
      "type": "string",
      "default": "100%"
    },
    "titleLineHeightMobile": {
      "type": "string",
      "default": "110%"
    },
    "titleLetterSpacing": {
      "type": "string",
      "default": "-4%"
    },
    "titleTextTransform": {
      "type": "string",
      "default": "uppercase"
    },
    "titleTextShadow": {
      "type": "string",
      "default": "0px 1px 1px #00000080"
    },
    "accentColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "accentFontSize": {
      "type": "string",
      "default": "98px"
    },
    "accentFontSizeMobile": {
      "type": "string",
      "default": "48px"
    },
    "accentFontFamily": {
      "type": "string",
      "default": "Be Vietnam Pro"
    },
    "accentFontWeight": {
      "type": "string",
      "default": "700"
    },
    "accentLineHeight": {
      "type": "string",
      "default": "120%"
    },
    "accentLineHeightMobile": {
      "type": "string",
      "default": "110%"
    },
    "accentLetterSpacing": {
      "type": "string",
      "default": "-4%"
    },
    "accentTextShadow": {
      "type": "string",
      "default": "0px 1px 1px #00000080"
    },
    "ctaMarginTop": {
      "type": "string",
      "default": "0px"
    },
    "ctaMarginTopMobile": {
      "type": "string",
      "default": "0px"
    },
    "ctaFontFamily": {
      "type": "string",
      "default": "Be Vietnam Pro"
    },
    "ctaFontSize": {
      "type": "string",
      "default": "16px"
    },
    "ctaFontSizeMobile": {
      "type": "string",
      "default": "14px"
    },
    "marginDesktop": { "type": "object", "default": {} },
    "marginMobile": { "type": "object", "default": {} },
    "paddingDesktop": { "type": "object", "default": {} },
    "paddingMobile": { "type": "object", "default": {} },
    "glassPositionX": {
      "type": "string",
      "default": "left"
    },
    "glassPositionY": {
      "type": "string",
      "default": "middle"
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "glassWidth": {
      "type": "number",
      "default": 60
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  }
}