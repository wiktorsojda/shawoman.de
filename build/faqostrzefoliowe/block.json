{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ourblocktheme/faqostrzefoliowe",
  "title": "FAQ Ostrze Foliowe",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Często zadawane pytania"
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "headingTag": {
