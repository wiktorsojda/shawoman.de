{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ourblocktheme/cechywodo",
  "title": "Cechy Wodoodporność",
  "attributes": {
    "title": {
      "type": "string",
      "default": "NIEWIARYGODNIE WYGODNY"
    },
    "description": {
      "type": "string",
      "default": "Wbudowana lampka LED oświetla trudno dostępne miejsca. Antypoślizgowa powierzchnia i poręczny design i wskaźnik naładowania sprawiają, że Shav jest wyjątkowo przyjemny w użytkowaniu - gdziekolwiek jesteś. Czyści się w kilka sekund pod bieżącą wodą i ładuje szybko w stacji ładującej lub przez USB-C."
    },
    "backgroundImage": {
      "type": "string",
      "default": ""
    },
    "feature1Title": {
      "type": "string",
      "default": "Lampka LED"
    },
    "feature2Title": {
      "type": "string",
      "default": "120 minut na 1 ładowaniu"
    },
    "feature3Title": {
      "type": "string",
      "default": "Stacja ładująca"
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  }
}